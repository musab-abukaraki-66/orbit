# Copy to .env.local and fill in. Never commit .env.local.
#
# On Vercel, set the same variables in Project Settings → Environment
# Variables. Everything prefixed NEXT_PUBLIC_ is inlined into the browser
# bundle at build time — never put a secret behind that prefix.

# --- Supabase (required) ---------------------------------------------
# Local: run `supabase start` and copy the printed API URL + keys.
# Hosted: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security. The app itself never reads it;
# leave it empty unless you write an admin script. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site URL --------------------------------------------------------
# Absolute origin used in auth email redirects, invitation/welcome emails and
# OG metadata. Set this to your production domain on Vercel. If unset, the app
# falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Resend (transactional email, optional) --------------------------
# Without this, welcome and invitation emails are logged to the server console
# instead of being sent — invitation links still work.
RESEND_API_KEY=
# RESEND_FROM_EMAIL="Orbit <onboarding@resend.dev>"

# --- Playwright e2e (local only, optional) --------------------------
# Fixture accounts the e2e suite signs up/in with. Use throwaway addresses.
# E2E_TEST_EMAIL=orbit.demo.local@example.com
# E2E_TEST_PASSWORD=
# E2E_FRIEND_EMAIL=orbit.friend.local@example.com
# E2E_BASE_URL=http://localhost:3000
