# Copy to .env.local and fill in. Never commit .env.local.
#
# On Vercel, set the same variables in Project Settings → Environment
# Variables. Everything prefixed NEXT_PUBLIC_ is inlined into the browser
# bundle at build time — never put a secret behind that prefix.

# --- Supabase (required) ---------------------------------------------
# Local: run `supabase start` and copy the printed API URL + keys.
# Hosted: Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service-role key is NOT used by Orbit. Never add it to this app or to
# Vercel; every query goes through the anon key and Row Level Security.

# --- Site URL --------------------------------------------------------
# Absolute origin used in auth email redirects, invitation/welcome emails and
# OG metadata. Set this to your production domain on Vercel. If unset, the app
# falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Resend (transactional email, optional, free tier) ---------------
# Invitation and welcome emails. Without a key, Orbit still works: invitation
# links are shown in the UI to copy and share.
#
# 1. Create a free account at resend.com → API Keys → Create ("Sending access").
# 2. Paste it below (never commit .env.local) and on Vercel as RESEND_API_KEY.
# 3. Free tier without a verified domain: sender must stay onboarding@resend.dev
#    and mail is delivered ONLY to the Resend account's own email address.
#    Add + verify your domain in Resend (free) to email anyone, then set
#    RESEND_FROM_EMAIL to an address on that domain.
# 4. Optional — Supabase Auth emails (password reset, confirmations) through
#    the same account: Supabase dashboard → Authentication → SMTP Settings →
#    Enable custom SMTP: host smtp.resend.com, port 465, user "resend",
#    password = this API key, sender = the address you use below.
RESEND_API_KEY=
# RESEND_FROM_EMAIL="Orbit <invites@yourdomain.com>"

# --- Playwright e2e (local only, optional) --------------------------
# Fixture accounts the e2e suite signs up/in with. Use throwaway addresses.
# E2E_TEST_EMAIL=orbit.demo.local@example.com
# E2E_TEST_PASSWORD=
# E2E_FRIEND_EMAIL=orbit.friend.local@example.com
# E2E_BASE_URL=http://localhost:3000
